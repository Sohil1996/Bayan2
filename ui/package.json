{
  "name": "@bayan/ui",
  "version": "0.1.0",
  "description": "Bayan design system: tokens and React components (Tailwind CSS v4), documented in Storybook.",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./fonts.css": "./src/styles/fonts.css",
    "./theme.css": "./src/styles/theme.css"
  },
  "files": [
    "dist",
    "src/styles"
  ],
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "vite build && tsc -p tsconfig.build.json",
    "build-storybook": "storybook build -o storybook-static",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@fontsource-variable/cairo": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.76.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.7",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
